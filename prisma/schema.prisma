generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  role             String
  experienceLevel  String
  location         String
  skills           String[]
  interests        String[]
  goals            String[]
  workPreferences  String[]
  avatarUrl        String?
  passwordHash     String?
  profileCompleted Boolean  @default(false)
  createdAt        DateTime @default(now())

  savedOpportunities SavedOpportunity[]
  applications       Application[]
  sessions           Session[]

  @@index([email])
}

model Opportunity {
  id              String   @id @default(uuid())
  title           String
  organization    String
  description     String
  type            String
  location        String
  remote          Boolean
  deadline        DateTime
  requiredSkills  String[]
  experienceLevel String
  eligibility     String
  applicationUrl  String
  tags            String[]
  createdAt       DateTime @default(now())
  matchScore      Float?

  savedBy        SavedOpportunity[]
  applications   Application[]
  readinessPlans ReadinessPlan[]

  @@index([type])
  @@index([deadline])
  @@index([createdAt])
}

model SavedOpportunity {
  id            String   @id @default(uuid())
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id                     String            @id @default(uuid())
  userId                 String
  opportunityId          String
  status                 ApplicationStatus @default(APPLIED)
  appliedAt              DateTime          @default(now())
  notes                  String?
  externalApplicationUrl String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@index([status])
}

model ReadinessPlan {
  id            String   @id @default(uuid())
  opportunityId String
  days          Json
  generatedAt   DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
